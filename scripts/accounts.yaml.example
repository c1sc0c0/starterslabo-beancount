# Portal rekening code → Beancount Expenses account.
# amount_mode: how Factuurbedrag is treated in v1 (no VAT split yet).
amount_mode: incl_vat  # or excl_vat — do not invent VAT legs until confirmed

currency: EUR

defaults:
  income: Income:Sales
  receivables: Assets:Receivables:Customers
  clearing: Assets:Clearing:Starterslabo
  payables: Liabilities:Payables:Suppliers
  unknown_expense: Expenses:610999:Other

# When Te betalen a. leverancier looks like "betaald", credit clearing.
# Otherwise credit payables (open supplier invoice).
purchase_paid_markers:
  - betaald
  - paid
  - "0"
  - "0,00"
  - "0.00"

accounts:
  "610999": Expenses:610999:Other
  "612105": Expenses:612105:PhoneInternet
  "612115": Expenses:612115:Subscriptions
  "612125": Expenses:612125:Software
  "612300": Expenses:612300:OfficeSupplies
  "613160": Expenses:613160:Insurance
  "613220": Expenses:613220:Memberships
  "613265": Expenses:613265:Training
  "614100": Expenses:614100:Advertising
  "614317": Expenses:614317:Mileage
  "614324": Expenses:614324:MileageAlt
  "614330": Expenses:614330:PublicTransport
  "614345": Expenses:614345:Restaurant
